#
# For a description of the syntax of this configuration file,
# see docs/Kconfig-language.txt.
#

menu "Archival Utilities"

config FEATURE_SEAMLESS_XZ
	bool "Make tar, rpm, modprobe etc understand .xz data"
	default y

config FEATURE_SEAMLESS_LZMA
	bool "Make tar, rpm, modprobe etc understand .lzma data"
	default y

config FEATURE_SEAMLESS_BZ2
	bool "Make tar, rpm, modprobe etc understand .bz2 data"
	default y

config FEATURE_SEAMLESS_GZ
	bool "Make tar, rpm, modprobe etc understand .gz data"
	default y

config FEATURE_SEAMLESS_Z
	bool "Make tar, rpm, modprobe etc understand .Z data"
	default n  # it is ancient

config FEATURE_SEAMLESS_ZSTD
	bool "Make tar, rpm, modprobe etc understand .zst data"
	default y
	help
	This requires external zstd and unzstd binaries.

INSERT

config FEATURE_PATH_TRAVERSAL_PROTECTION
	bool "Prevent extraction of filenames with /../ path component"
	default y
	help
	busybox tar and unzip remove "PREFIX/../" (if it exists)
	from extracted names.
	This option enables this behavior for all other unpacking applets,
	such as cpio, ar, rpm.
	GNU cpio 2.15 has NO such sanity check.

config FEATURE_CRC32_4BYTES
	bool "Use 4-slice CRC32 table, 3x faster (5Kb)"
	default y
	depends on GUNZIP || GZIP || UNZIP || BUNZIP2 || LZOP || XZ
	help
	Replace the standard 1KB CRC32 lookup table with a 4-slice
	4KB table for 3x faster CRC32 computation during inflate.

	The 4-slice algorithm processes 4 bytes in parallel using
	bitwise operations, which is significantly faster on modern
	CPUs (gunzip +25% faster) but requires 4KiB of look-up tables.

	This option has no effect on compression (gzip -c), only on
	decompression paths that verify CRC32.

	Say N if you are compiling for a very constrained tiny system.
	Say Y if you want faster gunzip/zcat or for running on desktops.

endmenu
